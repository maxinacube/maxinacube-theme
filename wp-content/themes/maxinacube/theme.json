{
  "$schema": "https://schemas.wp.org/wp/6.2/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "duotone": [],
      "gradients": [],
      "link": false,
      "palette": [
        {
          "name": "Black",
          "slug": "black",
          "color": "#000"
        },
        {
          "name": "Dark",
          "slug": "dark",
          "color": "#211d1e"
        },
        {
          "name": "Grey",
          "slug": "grey",
          "color": "#7f7f7f"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#fff"
        }
      ]
    },
    "custom": {
      "typography": {
        "fontFamily": "var(--wp--preset--font-family--outfit)"
      },
      "layout": {
        "contentSize": "1420px"
      },
      "font-size": {
        "mobile": {
          "heading1": "52px",
          "heading2": "48px",
          "heading3": "44px",
          "heading4": "38px",
          "heading5": "24px",
          "heading6": "20px",
          "bodySmall": "12px",
          "bodyMedium": "14px",
          "bodyLarge": "16px"
        },
        "desktop": {
          "heading1": "96px",
          "heading2": "82px",
          "heading3": "60px",
          "heading4": "50px",
          "heading5": "40px",
          "heading6": "34px",
          "bodySmall": "16px",
          "bodyMedium": "18px",
          "bodyLarge": "20px"
        }
      }
    },
    "layout": {
      "contentSize": "var(--wp--custom--layout--content-size)"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["rem", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": false,
      "lineHeight": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Outfit\", sans-serif",
          "name": "Outfit",
          "slug": "outfit",
          "fontFace": [
            {
              "fontFamily": "Outfit",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [
                "file:./static/fonts/Outfit/Outfit-VariableFont_wght.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"Arvo\", serif",
          "name": "Arvo",
          "slug": "arvo",
          "fontFace": [
            {
              "fontFamily": "Arvo",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [
                "file:./static/fonts/Arvo/Arvo-Regular.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "var(--wp--custom--font-size--desktop--body-small)"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "var(--wp--custom--font-size--desktop--body-medium)"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "var(--wp--custom--font-size--desktop--body-large)"
        }
      ]
    },
    "blocks": {
      "core/columns": {
        "spacing": {
          "blockGap": true
        }
      },
      "core/button": {
        "color": {
          "palette": []
        }
      }
    }
  },
  "styles": {
    "color": {},
    "elements": {
      "h1": {},
      "h2": {},
      "h3": {},
      "h4": {},
      "h5": {},
      "h6": {},
      "link": {}
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--outfit)"
    },
    "blocks": {
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arvo"
        }
      }
    }
  }
}
